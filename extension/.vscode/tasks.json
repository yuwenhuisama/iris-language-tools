{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build iris-lsp",
      "type": "process",
      "command": "cargo",
      "args": ["build", "--offline", "-p", "iris-lsp"],
      "options": { "cwd": "${workspaceFolder}/.." },
      "problemMatcher": []
    },
    { "type": "npm", "script": "compile", "problemMatcher": "$tsc" },
    {
      "label": "build Iris development tools",
      "dependsOrder": "sequence",
      "dependsOn": ["build iris-lsp", "npm: compile"],
      "problemMatcher": []
    }
  ]
}
